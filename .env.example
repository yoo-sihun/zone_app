OPENAI_API_KEY=sk-...
# false로 두면 OCR/AI 사진판단/AI 코멘트/AI 관리팁 전부 OpenAI 호출을 안 하고 꺼짐 상태로
# 즉시 실패(핵심 분석 기능엔 영향 없음). OpenAI 비용이 걱정될 때 Render 환경변수에서
# true/false만 바꾸고 재배포하면 됨. 비워두거나 안 넣으면 기본값 true(켜짐).
AI_ENABLED=true

# true로 두면 /docs(Swagger)·/redoc·/openapi.json이 열림 — 로컬 개발 중 API 확인용.
# 기본값(비워두거나 false)은 꺼짐 — 배포 환경에서 전체 엔드포인트 목록이 그대로
# 노출되는 걸 막기 위해 기본적으로 숨김.
SHOW_DOCS=false

# Supabase 프로젝트 설정 > Database > Connection string (URI, mode: Session) 에서 복사.
# postgres:// 로 시작하면 postgresql+psycopg2:// 로 바꿔서 넣기.
# 비워두면 로컬 sqlite(zone.db)로 자동 동작.
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres

# 공공데이터포털(data.go.kr)에서 "한국환경공단_에어코리아_대기오염정보" 활용신청 후 발급받은
# 인코딩된 서비스키(URL-encoded 그대로, 다시 인코딩하지 말 것). 미세먼지(PM2.5) 수동 동기화용.
AIRKOREA_API_KEY=
# 기준 측정소명. 비워두면 "종로구"(서울) 기본값 사용.
AIRKOREA_STATION=종로구

# 기상청 API Hub(apihub.kma.go.kr — data.go.kr 아님)에서 "동네예보(초단기실황·초단기예보·단기예보) 조회"
# 활용신청 후 발급받은 인증키. 습도 수동 동기화용(오늘 날짜만 지원).
KMA_API_KEY=
# 기상청 격자 좌표. 비워두면 60/127(종로구, AIRKOREA_STATION 기본값과 같은 지역) 기본값 사용.
KMA_NX=60
KMA_NY=127

# 공공데이터포털(data.go.kr)에서 "기상청_생활기상지수 조회서비스" 활용신청 후 발급받은
# 인코딩된 서비스키(URL-encoded 그대로, AIRKOREA_API_KEY와 같은 방식). 자외선지수 동기화용.
KMA_UV_API_KEY=
# 생활기상지수 지점코드. 비워두면 1100000000(서울) 기본값 사용.
KMA_AREA_NO=1100000000
